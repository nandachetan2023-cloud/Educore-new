{
  "name": "educore-node",
  "version": "0.1.0",
  "private": true,
  "description": "White-label LMS / online course marketplace (Node.js port of the EduCore Laravel platform)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "start": "concurrently \"npm:start:api\" \"npm:start:web\"",
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:web": "node scripts/run-next.cjs dev -p 3004",
    "start:api": "npm --prefix apps/api run start",
    "start:web": "node scripts/run-next.cjs start -p 3004",
    "build": "npm run build --workspace=@educore/api && npm run build --workspace=@educore/web",
    "db:generate": "npm run prisma:generate --workspace=@educore/api",
    "db:migrate": "npm run prisma:migrate --workspace=@educore/api",
    "db:seed": "npm run prisma:seed --workspace=@educore/api",
    "db:studio": "npm run prisma:studio --workspace=@educore/api"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
